{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mechlab-web",
  // El script solo se ejecuta en las rutas de run_worker_first; el resto son assets estáticos.
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // La web solo se publica en mw-builder.com: sin estas opciones, cada despliegue vuelve a
  // activar las direcciones *.workers.dev de la cuenta, aunque estén desactivadas en el panel.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/mercs/api/*"]
  },
  // Envío de los mensajes de feedback por Cloudflare Email Routing. La dirección de destino es el
  // secreto FEEDBACK_TO, configurado en el panel de Cloudflare.
  "send_email": [{ "name": "FEEDBACK_EMAIL" }],
  // Necesario para las vistas previas de cada pull request (npx wrangler preview).
  "previews": {}
}
