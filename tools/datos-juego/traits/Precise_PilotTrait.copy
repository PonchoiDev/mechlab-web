   PilotTraitName=NSLOCTEXT("[0F18EF7D4CCBA3D150E3598428B22E11]", "4E5FAD3F472BF7BB81CC44A427381341", "Precise")
   PilotTraitLongDescription=NSLOCTEXT("[0F18EF7D4CCBA3D150E3598428B22E11]", "6308413E4AA42E53D76B12851E14B40E", "This pilot prefers putting focused damage on a single location. Increases range and velocity for standard autocannons, solid slug LBX autocannons, gauss rifles, rifles, and single projectile PPCs by {ProjectileQuirk}%. Also reduces laser duration by {LaserQuirk}%.")
