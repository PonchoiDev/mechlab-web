ption=NSLOCTEXT("", "F40F70994BC9388DFA6E569885A66087", "Grigori Kovalenko was a loyal Capellan who viewed the Federated Suns initial incursions into Capellan territory as a cowardly sneak attack. Unwilling to participate on any attacks against the Capellans, he abandoned the Twelfth Star Guards and offered his services as a mercenary to the Capellan Confederation. With the fall of Tikonov in 3029 Grigori took the theft of the Cataphract design and production as his new cause. Styling himself as a knight of old, and a quest to take back all Cataphracts from non-Capellans, he quickly salvaging one for his own use. Replacing his aging Centurion and dubbing it Ilya Muromets, after the legendary knight of Slavic myth."),SelectedWeaponHardPoints=("Torso_Left_EH1_mediumlaser","Torso_Right_BH1_autocannon10","Torso_Right_EH1_mediumlaser","Forearm_Right_EH2_smalllaser","Forearm_Right_BH1_autocannon5","Forearm_Left_BH1_autocannon5","Arm_Left_Hand_Actuator_Melee","Arm_Right_LowerArm_Actuator_Melee"),bRecalculateFreeSlotsOnSave=True,EquipmentAllocation=(ArmorDataAssetId=(Id="MWArmorDataAsset:StandardArmor"),StructureDataAssetId=(Id="MWStructureDataAsset:StandardStructure"),AllowedHeatSinkType=(TagName="Equipment.HeatSinks.Single"),SlotData=((SlotTypeDataAssetId=(Id="MWSlotTypeDataAsset:General_SlotType"),SlotCounts=((Head, 1),(CenterTorso, 2),(LeftTorso, 8),(LeftArm, 4),(LeftLeg, 2),(RightTorso, 4),(RightArm, 4),(RightLeg, 2))),(SlotTypeDataAssetId=(Id="MWSlotTypeDataAsset:EngineHeatsink_SlotType"),SlotCounts=((CenterTorso, 1)))),InternalEquipment=(LifeSupport,Sensors,Cockpit,Gyro,LeftArm_Shoulder,LeftArm_UpperActuator,RightArm_Shoulder,RightArm_UpperActuator,LeftLeg_Hip,LeftLeg_UpperActuator,LeftLeg_LowerActuator,LeftLeg_FootActuator,RightLeg_Hip,RightLeg_UpperActuator,RightLeg_LowerActuator,RightLeg_FootActuator),OtherCompatibilities=(KelMechEquipmentCompatibilityFunction_TechBase'"KelMechEquipmentCompatibilityFunction_TechBase_1"'),TotalTraitSlots=8),RefitCosts=(Id="MWMechRe