d and built by Corean Enterprises as an operating partner for the already successful Trebuchet. After supplying a steady stream of spare parts to AFFS line units for nearly 150 years, and buoyed by the success and warm reception of the design as a whole, Corean built a secondary manufacturing facility on New Avalon in 3012. The Centurion represents a well-rounded combat platform in its tonnage range and is known for making slow, steady advances while being tough enough to absorb considerable punishment."),SelectedWeaponHardPoints=("Torso_Left_MH1_lrm10","Torso_Center_EH1_mediumlaser","Torso_Center_EH2_mediumlaser","Forearm_Right_BH1_autocannon10","Arm_Left_Hand_Actuator_Melee","Arm_Right_LowerArm_Actuator_Melee"),BlankWeaponHardPoints=("Torso_Left_MB1_blank"),bRecalculateFreeSlotsOnSave=True,EquipmentAllocation=(ArmorDataAssetId=(Id="MWArmorDataAsset:StandardArmor"),StructureDataAssetId=(Id="MWStructureDataAsset:StandardStructure"),AllowedHeatSinkType=(TagName="Equipment.HeatSinks.Single"),SlotData=((SlotTypeDataAssetId=(Id="MWSlotTypeDataAsset:General_SlotType"),SlotCounts=((Head, 1),(CenterTorso, 0),(LeftTorso, 10),(LeftArm, 8),(LeftLeg, 2),(RightTorso, 12),(RightArm, 5),(RightLeg, 2)))),InternalEquipment=(LifeSupport,Sensors,Cockpit,Gyro,LeftArm_Shoulder,LeftArm_UpperActuator,RightArm_Shoulder,RightArm_UpperActuator,LeftLeg_Hip,LeftLeg_UpperActuator,LeftLeg_LowerActuator,LeftLeg_FootActuator,RightLeg_Hip,RightLeg_UpperActuator,RightLeg_LowerActuator,RightLeg_FootActuator),OtherCompatibilities=(KelMechEquipmentCompatibilityFunction_TechBase'"KelMechEquipmentCompatibilityFunction_TechBase_1"'),TotalTraitSlots=6),RefitCosts=(Id="MWMechRefitCostsDataAsset:CN9_200_Std_RefitCosts"),EngineRating=200,BaseChassisCost=2672499,SalvageShareCost=25,bIsDefaultVariant=True)
