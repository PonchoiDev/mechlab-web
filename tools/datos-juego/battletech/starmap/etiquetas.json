  "descripcion": "Whether recently colonized or re-colonized, the settlements on this world are new.",
  "nombre": "Recently Colonized",
  "visible": true
 },
 "planet_other_pirate": {
  "descripcion": "Pirates are an ever-present threat in this system, using unregistered JumpShips and pirate jump points to prey on commerce.",
  "nombre": "Pirate Presence",
  "visible": true
 },
 "planet_other_plague": {
  "descripcion": "One or more planets in this system are quarantined due to a particularly virulent biohazard, possibly an uncontrolled bioweapon.",
  "nombre": "Plague Quarantine",
  "visible": true
 },
 "planet_other_prison": {
  "descripcion": "This planet is used as a prison for the dangerous and undesirable.",
  "nombre": "Prison Planet",
  "visible": true
 },
 "planet_other_ruins": {
  "descripcion": "The surface of this world includes ruins of earlier settlements, whether lost in the Succession Wars, or from even earlier periods.",
