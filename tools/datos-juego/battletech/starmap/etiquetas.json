  "descripcion": "Many travel routes come together at this world's jump points, making it a nexus for trade and information.",
  "nombre": "Travel Hub",
  "visible": true
 },
 "planet_other_megacity": {
  "descripcion": "A massive city dominates some or all of this world's land mass, and most residents live within the city.",
  "nombre": "MegaCity",
  "visible": true
 },
 "planet_other_megaforest": {
  "descripcion": "This world is covered in a massive forest across its entire climate spectrum.",
  "nombre": "Planetwide Forest",
  "visible": true
 },
