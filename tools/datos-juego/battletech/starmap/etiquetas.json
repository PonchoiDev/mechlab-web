 "planet_other_floatingworld": {
  "descripcion": "A dense cloud layer covers the surface of this world, and settlements exist only on high mountain peaks above the clouds.",
  "nombre": "Dense Cloud Layer",
  "visible": true
 },
 "planet_other_fungus": {
  "descripcion": "A planet-wide fungus colony dominates this world, making it dangerous to humans.",
  "nombre": "Dominant Fungus",
  "visible": true
 },
