 "planet_other_alienvegetation": {
  "descripcion": "This world is dominated by alien vegetation, either because it is too difficult to remove, or because of insufficient resources to remove it.",
  "nombre": "Alien Vegetation",
  "visible": true
 },
 "planet_other_battlefield": {
  "descripcion": "This world is the site of one of the many battles of the past five centuries, and wreckage and technology can still be found here.",
  "nombre": "Battlefield",
  "visible": true
 },
 "planet_other_blackmarket": {
  "descripcion": "A thriving black market here deals in rare and illicit goods, weapons, and even BattleMechs.",
  "nombre": "Black Market",
  "visible": true
 },
 "planet_other_boreholes": {
  "descripcion": "Deep boreholes into the planet's crust provide minerals and geothermal power for the inhabitants.",
  "nombre": "Geothermal Boreholes",
  "visible": true
 },
 "planet_other_capital": {
  "descripcion": "This world is a capital of one of the interstellar states of the region.",
  "nombre": "Regional Capital",
  "visible": true
 },
 "planet_other_comstar": {
  "descripcion": "ComStar maintains a presence on this world beyond the skeleton staff needed to operate the HPG arrays.",
  "nombre": "ComStar Presence",
  "visible": true
 },
 "planet_other_dragons": {
  "descripcion": "The branth, a leathery flying dragon-like reptile, is native to this planet, and conservationists work to preserve the species and protect its habitat.",
  "nombre": "Native Dragons",
  "visible": true
 },
 "planet_other_empty": {
  "descripcion": "This world has no permanent residents. Any inhabitants are transients living on orbital stations and at the jump points.",
  "nombre": "Uninhabited",
  "visible": true
 },
