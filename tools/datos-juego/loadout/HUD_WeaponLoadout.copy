      Begin Object Name="K2Node_BreakStruct_1"
         bMadeAfterOverridePinRemoval=True
         ShowPinForProperties(0)=(PropertyName="GaugeFill",PropertyFriendlyName="Gauge Fill",PropertyTooltip="The rate at which the MASC meter grows once engaged\nA value of 1 means it will take 1 second for the meter to fully fill up if it was empty",CategoryName="MASCStats",bCanToggleVisibility=True)
         ShowPinForProperties(1)=(PropertyName="GaugeDrain",PropertyFriendlyName="Gauge Drain",PropertyTooltip="The rate at which the MASC meter decreases once disengaged\nA value of 1 means it will take 1 second for the meter to fully deplete if it was full",CategoryName="MASCStats",bCanToggleVisibility=True)
         ShowPinForProperties(2)=(PropertyName="GaugeWarningPoint",PropertyFriendlyName="Gauge Warning Point",PropertyTooltip="The threshold of the MASC meter at which warnings that the meter is approaching the GaugeDamagePoint\nA value of 0.6 means warnings will appear when the meter is filled by 60%",CategoryName="MASCStats",bCanToggleVisibility=True)
         ShowPinForProperties(3)=(PropertyName="GaugeDamagePoint",PropertyFriendlyName="Gauge Damage Point",PropertyTooltip="The threshold of the MASC meter at which damage begins being dealt to user of the MASC\nA value of 0.8 means damage will be dealt when the meter is filled by 80%",CategoryName="MASCStats",bCanToggleVisibility=True)
         ShowPinForProperties(4)=(PropertyName="BoostSpeed",PropertyFriendlyName="Boost Speed",PropertyTooltip="By how much the top speed of the user of this MASC is increased while engaged\nA value of 0.25 means the user can travel at 125% of their top speed while engaged",CategoryName="MASCStats",bCanToggleVisibility=True)
         ShowPinForProperties(5)=(PropertyName="BoostAccel",PropertyFriendlyName="Boost Accel",PropertyTooltip="By how much the acceleration of the user of this MASC is increased while engaged\nA value of 0.25 means the user accelerates at 125% of their normal acceleration while engaged",CategoryName="MASCStats",bCanToggleVisibility=True)
         ShowPinForProperties(6)=(PropertyName="BoostDecel",PropertyFriendlyName="Boost Decel",PropertyTooltip="By how much the deceleration of the user of this MASC is increased while engaged\nA value of 0.25 means the user decelerates at 125% of their normal deceleration while engaged",CategoryName="MASCStats",bCanToggleVisibility=True)
         ShowPinForProperties(7)=(PropertyName="BoostTurn",PropertyFriendlyName="Boost Turn",PropertyTooltip="By how much the turn rate of the user of this MASC is increased\nA value of 0.25 means the user can travel at 125% of their normal turn rate while engaged",CategoryName="MASCStats",bCanToggleVisibility=True)
         ShowPinForProperties(8)=(PropertyName="DamageMin",PropertyFriendlyName="Damage Min",PropertyTooltip="The minimum damage that is dealt once the DamageThreshold is exceeded\nThe selected damage value is randomly chosen between MinDamage and MaxDamage",CategoryName="MASCStats",bCanToggleVisibility=True)
         ShowPinForProperties(9)=(PropertyName="DamageMax",PropertyFriendlyName="Damage Max",PropertyTooltip="The maximum damage that is dealt once the DamageThreshold is exceeded\nThe selected damage value is randomly chosen between MinDamage and MaxDamage",CategoryName="MASCStats",bCanToggleVisibility=True)
         ShowPinForProperties(10)=(PropertyName="DamageRate",PropertyFriendlyName="Damage Rate",PropertyTooltip="How frequently (in seconds) damage is applied once the DamageThreshold is exceeded",CategoryName="MASCStats",bCanToggleVisibility=True)
