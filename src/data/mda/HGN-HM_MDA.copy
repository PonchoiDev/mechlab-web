n_UIX.Highlander_Icon_UIX,TargetComponent=/Game/Objects/Mechs/Highlander/Target/Highlander_Target.Highlander_Target_C,Description=NSLOCTEXT("", "59BE115743A79E498454C38B84F1374F", "Raised among mercenaries her entire life, Rhonda Snord was born to be a MechWarrior. When she was a child, her father, Cranston Snord, was discharged from the Wolf\'s Dragoons accused of abandoning his post to hunt for ancient artwork. He would go on to form his own mercenary unit \'Snords Irregulars\' and built up a reputation as a treasure hunter and historian of the ancient Star League, building a collections of preserved artwork and texts from humanity\'s lost golden age. Although itself a relic of the Star League, Rhonda\'s \'Heavy Metal\' was a beast of her own creation. Sporting a distinct Pink camo scheme and mounting external stadium speakers, Rhonda used Heavy Metal to flood the battlefield with late 20th century rock and heavy metal music as she took to the field."),SelectedWeaponHardPoints=("Torso_Left_MH1_lrm20","Torso_Left_MH2_srm6","Forearm_Right_BH1_gaussrifle","Forearm_Left_EH1_mediumlaser","Forearm_Left_EH2_mediumlaser","Forearm_Left_EH3_mediumlaser","Arm_Left_Hand_Actuator_Melee","Arm_Right_LowerArm_Actuator_Melee"),bRecalculateFreeSlotsOnSave=True,EquipmentAllocation=(ArmorDataAssetId=(Id="MWArmorDataAsset:StandardArmor"),StructureDataAssetId=(Id="MWStructureDataAsset:StandardStructure"),AllowedHeatSinkType=(TagName="Equipment.HeatSinks.Double"),AllowedJumpJetType=(TagName="Equipment.JumpJets.Class1"),SlotData=((SlotTypeDataAssetId=(Id="MWSlotTypeDataAsset:General_SlotType"),SlotCounts=((Head, 1),(CenterTorso, 1),(LeftTorso, 2),(LeftArm, 5),(LeftLeg, 2),(RightTorso, 7),(RightArm, 2),(RightLeg, 2))),(SlotTypeDataAssetId=(Id="MWSlotTypeDataAsset:JumpJetClass1_SlotType"),SlotCounts=((Head, 0),(CenterTorso, 1),(LeftTorso, 2),(RightTorso, 2),(LeftArm, 0),(RightArm, 0),(LeftLeg, 0),(RightLeg, 0))),(SlotTypeDataAssetId=(Id="MWSlotTypeDataAsset:EngineHeatsink_SlotType"),SlotCo