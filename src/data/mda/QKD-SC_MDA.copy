ter of Defiance Industry\'s new \'Mech hatchet, in the form of the trench blade equipped to \'Scrapper\', her customized Quickdraw. She could have had a lucrative future in the gladiatorial circuits, had she remained. However, when word reached her of a resistance movement in her homeland, to free the Rasalhague Military District of Draconis Combine control, she felt a sense of duty to her homeland and people, and departed Solaris with her \'Mech to provide the rebels with whatever aid she could."),SelectedWeaponHardPoints=("Torso_Left_MH1_srm6","Torso_Center_MH1_srm4","Torso_Right_MH1_srm6","Arm_Right_Heavy_MeleeWeapon","Forearm_Left_EH1_mediumlaser","Arm_Left_Hand_Actuator_Melee"),BlankWeaponHardPoints=("Torso_Center_EH1_blank"),bRecalculateFreeSlotsOnSave=True,EquipmentAllocation=(ArmorDataAssetId=(Id="MWArmorDataAsset:StandardArmor"),StructureDataAssetId=(Id="MWStructureDataAsset:EndoSteelStructure"),AllowedHeatSinkType=(TagName="Equipment.HeatSinks.Single"),AllowedJumpJetType=(TagName="Equipment.JumpJets.Class3"),SlotData=((SlotTypeDataAssetId=(Id="MWSlotTypeDataAsset:General_SlotType"),SlotCounts=((Head, 1),(CenterTorso, 0),(LeftTorso, 8),(LeftArm, 7),(LeftLeg, 2),(RightTorso, 8),(RightArm, 5),(RightLeg, 2))),(SlotTypeDataAssetId=(Id="MWSlotTypeDataAsset:JumpJetClass3_SlotType"),SlotCounts=((Head, 0),(CenterTorso, 1),(LeftTorso, 2),(RightTorso, 2),(LeftArm, 0),(RightArm, 0),(LeftLeg, 0),(RightLeg, 0))),(SlotTypeDataAssetId=(Id="MWSlotTypeDataAsset:EngineHeatsink_SlotType"),SlotCounts=((CenterTorso, 2)))),InternalEquipment=(LifeSupport,Sensors,Cockpit,Gyro,LeftArm_Shoulder,LeftArm_UpperActuator,RightArm_Shoulder,RightArm_UpperActuator,LeftLeg_Hip,LeftLeg_UpperActuator,LeftLeg_LowerActuator,LeftLeg_FootActuator,RightLeg_Hip,RightLeg_UpperActuator,RightLeg_LowerActuator,RightLeg_FootActuator),OtherCompatibilities=(KelMechEquipmentCompatibilityFunction_TechBase'"KelMechEquipmentCompatibilityFunction_TechBase_1"'),TotalTraitSlots=9),RefitCosts=(Id="MWMechRefitCosts