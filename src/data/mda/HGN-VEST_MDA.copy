NSLOCTEXT("[833FCEB04A037820DAB42AB5F0A40F57]", "FF581742424228A647F63D929ED2EA65", "First produced in 2592, the Highlander served the Star League Defense Forces with distinction for almost two centuries, and earned its place in the history books with an absolutely stellar combat record. Designed to stand alone in the defense of a city, or to provide support for a mixed type attack, the Highlander makes up for its slow speed with the ability to leap over obstacles. When the Gauss Rifle fell out of use during the technological decline of the post-Star League era, many Highlanders were forced to downgrade their main weapon to an autocannon, though some occasionally sport PPCs."),SelectedWeaponHardPoints=("Torso_Left_MH2_srm6","Torso_Right_EH1_mediumlaser","Arm_Left_Assault_MeleeWeapon","Forearm_Right_BH1_autocannon20","Torso_Right_EH2_mediumlaser","Torso_Left_MH1_srm6"),bRecalculateFreeSlotsOnSave=True,EquipmentAllocation=(ArmorDataAssetId=(Id="MWArmorDataAsset:StandardArmor"),StructureDataAssetId=(Id="MWStructureDataAsset:EndoSteelStructure"),AllowedHeatSinkType=(TagName="Equipment.HeatSinks.Single"),AllowedJumpJetType=(TagName="Equipment.JumpJets.Class1"),SlotData=((SlotTypeDataAssetId=(Id="MWSlotTypeDataAsset:General_SlotType"),SlotCounts=((Head, 1),(CenterTorso, 1),(LeftTorso, 2),(LeftArm, 3),(LeftLeg, 2),(RightTorso, 9),(RightArm, 3),(RightLeg, 2))),(SlotTypeDataAssetId=(Id="MWSlotTypeDataAsset:JumpJetClass1_SlotType"),SlotCounts=((Head, 0),(CenterTorso, 1),(LeftTorso, 1),(RightTorso, 1),(LeftArm, 0),(RightArm, 0),(LeftLeg, 0),(RightLeg, 0))),(SlotTypeDataAssetId=(Id="MWSlotTypeDataAsset:MASC_MKV_SlotType"),SlotCounts=((LeftTorso, 1)))),InternalEquipment=(LifeSupport,Sensors,Cockpit,Gyro,LeftArm_Shoulder,LeftArm_UpperActuator,RightArm_Shoulder,RightArm_UpperActuator,LeftLeg_Hip,LeftLeg_UpperActuator,LeftLeg_LowerActuator,LeftLeg_FootActuator,RightLeg_Hip,RightLeg_UpperActuator,RightLeg_LowerActuator,RightLeg_FootActuator),OtherCompatibilities=(KelMechEquipmentCom