get.Firestarter_Target_C,Description=NSLOCTEXT("", "751CBF8B4E2F6CE490E2DDA5A90B0FC7", "Portia \'Torrent\' Ryan claims to be a relation of the famed pirate Redjack Ryan. Her timely interruption of an assassination attempt on Paula \'Lady Death\' Trevaline quickly earned her the famed pirate\'s favor, as well as the command of Scourge Company. Obsessed with detail, Portia has served with distinction on several scouting missions along the Concordat border. Perhaps more distinctive however is her penchant for using her Firestarter to set off incredible conflagrations. Her obsessive nature is at work here too, as when these raging fires are viewed from above they bear a remarkable symmetry that some liken to works of art. Perhaps it\'s this artistic mayhem that caused her to modify her \'Mech, moving all the flamers into the arms for extra precision."),SelectedWeaponHardPoints=("Torso_Left_BH1_machinegun","Torso_Left_BH2_machinegun","Torso_Right_BH1_machinegun","Torso_Right_BH2_machinegun","Forearm_Right_EH1_flamer","Forearm_Right_EH2_flamer","Forearm_Left_EH1_flamer","Forearm_Left_EH2_flamer","Arm_Left_LowerArm_Actuator_Melee","Arm_Right_LowerArm_Actuator_Melee"),bRecalculateFreeSlotsOnSave=True,EquipmentAllocation=(ArmorDataAssetId=(Id="MWArmorDataAsset:StandardArmor"),StructureDataAssetId=(Id="MWStructureDataAsset:EndoSteelStructure"),AllowedHeatSinkType=(TagName="Equipment.HeatSinks.Double"),AllowedJumpJetType=(TagName="Equipment.JumpJets.Class5"),SlotData=((SlotTypeDataAssetId=(Id="MWSlotTypeDataAsset:General_SlotType"),SlotCounts=((Head, 1),(CenterTorso, 1),(LeftTorso, 8),(LeftArm, 7),(LeftLeg, 2),(RightTorso, 8),(RightArm, 7),(RightLeg, 2))),(SlotTypeDataAssetId=(Id="MWSlotTypeDataAsset:JumpJetClass5_SlotType"),SlotCounts=((Head, 0),(CenterTorso, 1),(LeftTorso, 2),(RightTorso, 2),(LeftArm, 0),(RightArm, 0),(LeftLeg, 0),(RightLeg, 0)))),InternalEquipment=(LifeSupport,Sensors,Cockpit,Gyro,LeftArm_Shoulder,LeftArm_UpperActuator,RightArm_Shoulder,RightArm_UpperActuat